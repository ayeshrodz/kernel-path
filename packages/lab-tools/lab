#!/usr/bin/env bash
# lab - starts and finishes exercises on the Kernel Path home lab
# (same syntax as a classroom 'lab' command). Runs on workstation as student.
# Install or update: see section 1.6 of the guide, or run: lab update
# Version 7
set -euo pipefail

VERSION=7
BASE="${LAB_URL:-https://kernelpath.dev/lab}"
LAB_ROOT="${LAB_HOME:-$HOME}"
ARCHIVE="$LAB_ROOT/lab-archive"
SERVERS=(servera serverb serverc serverd)

# The servers this lab has: the system administration lab builds servera and serverb,
# the Ansible lab all four. A server that does not exist has no name in the lab's DNS.
lab_servers() { local h; for h in "${SERVERS[@]}"; do getent hosts "$h.lab.example.com" >/dev/null && echo "$h"; done; }

say()  { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }
fetch() { curl -fsSL --retry 2 "$BASE/$1"; }

usage() {
cat <<USAGE
lab v$VERSION - Kernel Path home lab exercises

  lab start  NAME [--force]    create ~/NAME with the exercise's starter files and
                               prepare the servers (packages, users, files)
  lab finish NAME [--delete]   undo the exercise's changes on the servers and put
                               ~/NAME away in ~/lab-archive (or delete it)
  lab grade  NAME [--checkpoint ID] [--json]   read-only project and host checks
  lab list                     exercises that have starter files
  lab check                    is the lab ready for the exercises?
  lab update                   download the newest version of this command
  lab version

lab works on workstation only. The managed hosts are reset from the Ubuntu
host, because the lab network cannot reach the host:  rht-vmctl reset servers
Starter files come from: $BASE
USAGE
}

need_name() { [[ -n ${1:-} ]] || die "which exercise? e.g. 'lab $SUB NAME' (see: lab list)"; }
valid_name() { [[ $1 =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "'$1' is not an exercise name"; }
stamp() { date +%Y%m%d-%H%M%S; }

cmd_start() {
  need_name "${1:-}"; valid_name "$1"
  local name="$1" force="${2:-}" dir="$LAB_ROOT/$1" stage manifest line dest src count=0
  [[ -z $force || $force == --force ]] || die "unknown option: $force"
  [[ ! -e $dir || $force == --force ]] || die "~/$name already exists (use --force to archive and restart)"
  stage=$(mktemp -d "$LAB_ROOT/.lab-$name.XXXXXX")
  LAB_TEMP_DIR="$stage"
  trap 'rm -rf -- "$LAB_TEMP_DIR"' EXIT
  manifest=$(fetch "$name/MANIFEST") || die "cannot download $name/MANIFEST; existing work is unchanged"
  [[ $manifest == \#* ]] || die "invalid manifest"
  while IFS= read -r line; do
    line="${line%%#*}"; line="${line//[[:space:]]/}"
    [[ -z $line ]] && continue
    [[ $line == @* ]] && continue   # hooks are for lab commands before version 5; setup actions replace them
    dest="${line%%=*}"; src="${line#*=}"
    [[ $dest =~ ^[a-zA-Z0-9_./-]+$ && $src =~ ^[a-zA-Z0-9_./-]+$ && $dest != /* && $src != /* && $dest != *..* && $src != *..* ]] || die "unsafe manifest path"
    mkdir -p "$stage/$(dirname "$dest")"
    fetch "$name/$src" > "$stage/$dest" || die "download failed: $src; exercise is not ready"
    count=$((count + 1))
  done <<< "$manifest"
  # The platform's own setup program and the exercise catalog: setup actions are named in
  # the catalog and implemented by prepare.py; no exercise downloads or runs a script of its own.
  fetch prepare.py > "$stage/.lab-prepare.py" || die "download failed: prepare.py"
  fetch graders.json > "$stage/.lab-catalog.json" || die "download failed: graders.json"
  if [[ -e $dir ]]; then
    mkdir -p "$ARCHIVE"; mv "$dir" "$ARCHIVE/$name-$(stamp)-$$"
    warn "previous work was archived"
  fi
  mv "$stage" "$dir"; trap - EXIT
  touch "$dir/.lab-not-ready"
  python3 "$dir/.lab-prepare.py" "$name" --project "$dir" --catalog "$dir/.lab-catalog.json" --base "$BASE" \
    || die "setup failed; exercise is not ready. Fix the reported error and restart with --force"
  rm -f "$dir/.lab-prepare.py" "$dir/.lab-catalog.json" "$dir/.lab-not-ready"
  say "~/$name is ready: cd ~/$name"
  echo "  If an earlier exercise left changes on the servers, finish it first (lab finish NAME) or reset them on the Ubuntu host: rht-vmctl reset servers"
}

cmd_finish() {
  need_name "${1:-}"; valid_name "$1"
  local name="$1" opt="${2:-}" dir="$LAB_ROOT/$1" dest work
  [[ -z $opt || $opt == --delete ]] || die "unknown option: $opt"
  # Undo what the exercise changed on the servers: the cleanup actions come from the exercise catalog.
  work=$(mktemp -d); LAB_TEMP_DIR="$work"; trap 'rm -rf -- "$LAB_TEMP_DIR"' EXIT
  if fetch prepare.py > "$work/prepare.py" 2>/dev/null && fetch graders.json > "$work/graders.json" 2>/dev/null; then
    python3 "$work/prepare.py" "$name" --finish --project "$dir" --catalog "$work/graders.json" --base "$BASE" \
      || warn "the cleanup on the servers did not finish; 'rht-vmctl reset servers' on the Ubuntu host always works"
  else
    warn "cannot download the cleanup steps; the servers are unchanged"
  fi
  if [[ ! -e $dir ]]; then
    warn "there is no ~/$name on workstation (already finished?)"
  elif [[ $opt == --delete ]]; then
    rm -rf "$dir" && say "deleted ~/$name"
  else
    [[ $PWD == "$dir" || $PWD == "$dir"/* ]] && cd "$HOME"
    dest="$ARCHIVE/$name-$(stamp)"
    mkdir -p "$ARCHIVE" && mv "$dir" "$dest" && say "moved ~/$name to ~/lab-archive/$(basename "$dest")"
    echo "  Your work is kept there. 'lab start $name' gives you a fresh copy."
  fi
  echo "  The servers were cleaned as far as this exercise goes. For the exact clean baseline, run on the Ubuntu host:  rht-vmctl reset servers"
}

cmd_grade() {
  need_name "${1:-}"; valid_name "$1"
  [[ ! -e "$LAB_ROOT/$1/.lab-not-ready" ]] || { warn "setup incomplete; restart this exercise before grading"; return 2; }
  local work
  work=$(mktemp -d)
  LAB_TEMP_DIR="$work"
  trap 'rm -rf -- "$LAB_TEMP_DIR"' EXIT
  fetch grade.py > "$work/grade.py" || { warn "cannot download grader"; return 2; }
  fetch graders.json > "$work/graders.json" || { warn "cannot download checks"; return 2; }
  python3 "$work/grade.py" "$@" --project "$LAB_ROOT/$1" --catalog "$work/graders.json"
}

cmd_list() { fetch INDEX || die "no connection to $BASE"; }

cmd_check() {
  local h u bad=0 missing="" users servers
  ok() { printf '  \033[32mPASS\033[0m %s\n' "$1"; }
  ko() { printf '  \033[31mFAIL\033[0m %s\n' "$1"; bad=1; }
  mapfile -t servers < <(lab_servers)
  if (( ${#servers[@]} )); then ok "servers in the lab: ${servers[*]}"; else ko "no lab servers resolve (servera.lab.example.com, ...)"; fi
  if command -v ansible >/dev/null 2>&1; then
    # The Ansible lab: Ansible connects as devops, and exercises also manage workstation.
    users=(devops student root)
    servers=(workstation "${servers[@]}")
  else
    users=(student root)
  fi
  for h in "${servers[@]}"; do
    missing=""
    for u in "${users[@]}"; do
      ssh -o BatchMode=yes -o ConnectTimeout=5 "$u@$h" true 2>/dev/null || missing+=" $u"
    done
    if [[ -z $missing ]]; then ok "$h: key login as ${users[*]}"; else ko "$h: no key login as:$missing"; fi
  done
  if command -v ansible >/dev/null 2>&1; then
    if ansible-galaxy collection list 2>/dev/null | grep -q '^ansible.posix'; then ok "ansible.posix collection"; else ko "ansible.posix collection"; fi
  else
    ok "Ansible is not installed (not needed for the system administration path)"
  fi
  if fetch INDEX >/dev/null 2>&1; then ok "starter files reachable"; else ko "cannot reach $BASE"; fi
  if (( bad )); then
    echo
    echo "  Missing key logins on the servers usually mean the 'clean' baseline was saved"
    echo "  before they were set up, and a reset removed them. Repeat the SSH key steps"
    echo "  of the lab setup in chapter 1, then on the Ubuntu host run:  rht-vmctl save"
    return 1
  fi
  say "the lab is ready"
}

cmd_update() {
  local self tmp
  self=$(readlink -f "$0"); tmp=$(mktemp)
  fetch lab > "$tmp" || die "could not download $BASE/lab"
  bash -n "$tmp" || die "the downloaded file is not a valid script; nothing changed"
  install -m 755 "$tmp" "$self" && rm -f "$tmp"
  say "updated $self: $("$self" version)"
}

SUB="${1:-help}"; shift || true
case "$SUB" in
  start)             cmd_start "$@" ;;
  finish)            cmd_finish "$@" ;;
  grade)             cmd_grade "$@" ;;
  list)              cmd_list ;;
  check)             cmd_check ;;
  update)            cmd_update ;;
  version|--version) echo "lab $VERSION" ;;
  help|-h|--help)    usage ;;
  *)                 usage; exit 1 ;;
esac
