    "lab": {
      "summary": "A hands-on exercise with tracked tasks, notes and an optional challenge brief.",
      "status": "stable",
      "since": 1,
      "placement": "block",
      "children": "tags",
      "attributes": {
        "id": {
          "type": "string",
          "description": "Stable id; task progress is stored under it.",
          "format": "id"
        },
        "title": {
          "type": "string",
          "description": "Exercise title.",
          "format": "shortText"
        },
        "exercise": {
          "type": "string",
          "description": "The lab tools exercise name (`lab start NAME`).",
          "format": "exerciseName"
        },
        "ownExercise": {
          "type": "boolean",
          "description": "The exercise exists only on this platform; there is no classroom equivalent.",
          "default": false
        },
        "starter": {
          "type": "boolean",
          "description": "`lab start` creates a starter project.",
          "default": true
        },
        "hosts": {
          "type": "string[]",
          "description": "Labels for the machines the exercise uses, such as 'workstation' or 'Ubuntu host'.",
          "format": "shortText",
          "maxItems": 12
        },
        "outcomes": {
          "type": "string[]",
          "description": "What the learner will have done.",
          "format": "text",
          "maxItems": 12
        },
        "objectives": {
          "type": "string[]",
          "description": "Objectives the exercise practises.",
          "format": "objectiveId",
          "maxItems": 12
        },
        "guided": {
          "type": "boolean",
          "description": "A guided exercise: its tasks say exactly what to do, so it needs no challenge brief. It still has an exercise definition whose start, grading and finish the lab tool performs.",
          "default": false
        }
      },
      "allowedChildren": [
        "task",
        "lab-notes",
        "lab-challenge",
        "lab-setup"
      ],
      "required": [
        "id",
        "title"
      ]
    },
