{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelpath.dev/schema/v1/source/lab.schema.json",
  "title": "Lab exercise",
  "description": "programs/<id>/lab/<exercise>.yml. Describes an exercise as data: starter files, setup actions and graded checkpoints. Every action and check is implemented by the platform's lab tools; content supplies values only, never commands. String values may contain the placeholders {host} (the inventory name) and {hostShort} (its first label), which the lab tools substitute and quote themselves.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "title",
    "page",
    "checkpoints"
  ],
  "properties": {
    "name": {
      "description": "The exercise name learners type in `lab start NAME`. Unique across all programs.",
      "$ref": "../common.schema.json#/$defs/id"
    },
    "title": {
      "$ref": "../common.schema.json#/$defs/shortText"
    },
    "page": {
      "description": "The section that teaches this exercise, as chNN/slug.",
      "type": "string",
      "pattern": "^ch[0-9]{2}/[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "transport": {
      "description": "How host checks reach the servers. ansible (the default): through Ansible with the exercise's inventory, for automation exercises. ssh: directly over SSH as root with key-based login from the learner's account, for exercises that do not use Ansible; each host check then names one host in 'on' and lists it in 'targets'.",
      "enum": [
        "ansible",
        "ssh"
      ]
    },
    "starter": {
      "description": "Files copied into ~/NAME. They are kept in lab/<exercise>/starter/ and never leave the project folder.",
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/relativePath"
      }
    },
    "setup": {
      "description": "Platform actions run after the starter files are in place, in order.",
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "checkpoints": {
      "description": "Named states the grader can check. 'final' is required.",
      "type": "object",
      "required": [
        "final"
      ],
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/checkpoint"
      }
    },
    "intentionalFaults": {
      "description": "The starter files contain deliberate faults for the learner to find, so content checks do not parse them.",
      "type": "boolean"
    },
    "note": {
      "description": "A short remark shown beside the title in the exercise list, for example that the project starts empty.",
      "$ref": "../common.schema.json#/$defs/shortText"
    }
  },
  "$defs": {
    "name": {
      "$ref": "../common.schema.json#/$defs/id"
    },
    "hostName": {
      "type": "string",
      "pattern": "^(?:localhost|[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*)$",
      "maxLength": 253
    },
    "hostPattern": {
      "description": "An Ansible host pattern made of inventory host or group names joined with ':', or 'control' for the control node (the learner's project directory).",
      "type": "string",
      "pattern": "^(?:control|[a-z0-9][a-z0-9._-]{0,100}(?::[a-z0-9][a-z0-9._-]{0,100}){0,4})$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._@+-]+(?:/[A-Za-z0-9._@+-]+)*$",
      "maxLength": 240
    },
    "absolutePath": {
      "description": "An absolute path on a managed host. Placeholders {host} and {hostShort} are allowed.",
      "type": "string",
      "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._@+{}-]*(?:/[A-Za-z0-9._@+{}-]+)*$",
      "maxLength": 240
    },
    "literal": {
      "description": "Text compared literally. Placeholders {host} and {hostShort} are allowed.",
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "not": {
        "pattern": "[\\u0000-\\u001F]"
      }
    },
    "regex": {
      "description": "An extended regular expression matched against whole lines.",
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "not": {
        "pattern": "[\\u0000-\\u001F]"
      }
    },
    "mode": {
      "type": "string",
      "pattern": "^[0-7]{3,4}$"
    },
    "account": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_-]{0,31}\\$?$"
    },
    "unitName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9@._-]{1,128}$"
    },
    "packageName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._+-]{1,128}$"
    },
    "imageRef": {
      "description": "A container image from an allowed registry.",
      "type": "string",
      "pattern": "^(?:ghcr\\.io|quay\\.io|registry\\.redhat\\.io|docker\\.io)/[a-z0-9._/-]+(?::[A-Za-z0-9._-]+|@sha256:[a-f0-9]{64})$"
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "description": {
          "$ref": "../common.schema.json#/$defs/shortText"
        },
        "files": {
          "description": "Project files that must exist and be non-empty.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "inventory": {
          "description": "The learner's inventory file, if it is not called 'inventory'.",
          "$ref": "#/$defs/relativePath"
        },
        "groups": {
          "description": "Groups the learner's inventory must define, with the hosts each must contain.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/groupName"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/hostName"
            }
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "files"
          ]
        },
        {
          "required": [
            "groups"
          ]
        },
        {
          "required": [
            "checks"
          ]
        }
      ]
    },
    "checkBase": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "on",
        "message"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "kind": {
          "type": "string"
        },
        "on": {
          "$ref": "#/$defs/hostPattern"
        },
        "targets": {
          "description": "Hosts that must have been checked; a missing host fails rather than passing silently.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/hostName"
          }
        },
        "message": {
          "$ref": "../common.schema.json#/$defs/shortText"
        }
      }
    },
    "check": {
      "description": "One typed, read-only check. 'kind' selects the platform implementation.",
      "oneOf": [
        {
          "$ref": "#/$defs/checkService"
        },
        {
          "$ref": "#/$defs/checkFirewall"
        },
        {
          "$ref": "#/$defs/checkPackage"
        },
        {
          "$ref": "#/$defs/checkFile"
        },
        {
          "$ref": "#/$defs/checkFileCompare"
        },
        {
          "$ref": "#/$defs/checkArchive"
        },
        {
          "$ref": "#/$defs/checkUser"
        },
        {
          "$ref": "#/$defs/checkMount"
        },
        {
          "$ref": "#/$defs/checkLogicalVolume"
        },
        {
          "$ref": "#/$defs/checkHttp"
        },
        {
          "$ref": "#/$defs/checkSelinux"
        },
        {
          "$ref": "#/$defs/checkSudoers"
        },
        {
          "$ref": "#/$defs/checkSshd"
        },
        {
          "$ref": "#/$defs/checkCron"
        },
        {
          "$ref": "#/$defs/checkBootTarget"
        },
        {
          "$ref": "#/$defs/checkAddress"
        },
        {
          "$ref": "#/$defs/checkHostname"
        },
        {
          "$ref": "#/$defs/checkCommands"
        },
        {
          "$ref": "#/$defs/checkGit"
        },
        {
          "$ref": "#/$defs/checkLint"
        }
      ]
    },
    "action": {
      "description": "One platform setup action.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "cert",
            "key",
            "commonName"
          ],
          "properties": {
            "action": {
              "const": "self-signed-cert"
            },
            "cert": {
              "$ref": "#/$defs/relativePath"
            },
            "key": {
              "$ref": "#/$defs/relativePath"
            },
            "commonName": {
              "$ref": "#/$defs/hostName"
            },
            "days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3650
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "path",
            "user",
            "password"
          ],
          "properties": {
            "action": {
              "const": "htpasswd"
            },
            "path": {
              "$ref": "#/$defs/relativePath"
            },
            "user": {
              "$ref": "#/$defs/account"
            },
            "password": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "path",
            "variable",
            "password"
          ],
          "properties": {
            "action": {
              "const": "password-hash-var"
            },
            "path": {
              "$ref": "#/$defs/relativePath"
            },
            "variable": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]{0,63}$"
            },
            "password": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,64}$"
            },
            "salt": {
              "type": "string",
              "pattern": "^[A-Za-z0-9./]{1,16}$"
            },
            "commented": {
              "description": "Write the variable as a YAML comment.",
              "type": "boolean"
            },
            "before": {
              "description": "Literal lines written before the variable.",
              "type": "array",
              "maxItems": 5,
              "items": {
                "$ref": "#/$defs/literal"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "path",
            "password"
          ],
          "properties": {
            "action": {
              "const": "vault-encrypt"
            },
            "path": {
              "$ref": "#/$defs/relativePath"
            },
            "password": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "namespace",
            "name"
          ],
          "properties": {
            "action": {
              "const": "pack-installed-collection"
            },
            "namespace": {
              "type": "string",
              "pattern": "^[a-z0-9_]{1,64}$"
            },
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9_]{1,64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "source"
          ],
          "properties": {
            "action": {
              "const": "build-collection"
            },
            "source": {
              "description": "A collection tree among the starter files.",
              "$ref": "#/$defs/relativePath"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "remote",
            "branches"
          ],
          "properties": {
            "action": {
              "const": "git-seed-remote"
            },
            "remote": {
              "description": "A bare repository created under ~/git-repos.",
              "type": "string",
              "pattern": "^[a-z0-9_-]+/[a-z0-9_.-]+\\.git$"
            },
            "author": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "email"
              ],
              "properties": {
                "name": {
                  "$ref": "../common.schema.json#/$defs/shortText"
                },
                "email": {
                  "type": "string",
                  "pattern": "^[a-z0-9._-]+@[a-z0-9.-]+$"
                }
              }
            },
            "branches": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "commits"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._/-]{1,100}$"
                  },
                  "from": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._/-]{1,100}$"
                  },
                  "commits": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "message",
                        "tree"
                      ],
                      "properties": {
                        "message": {
                          "$ref": "../common.schema.json#/$defs/shortText"
                        },
                        "tree": {
                          "description": "A folder among the lab's files whose contents become the commit's tree.",
                          "$ref": "#/$defs/relativePath"
                        },
                        "tag": {
                          "description": "A lightweight tag placed on this commit.",
                          "type": "string",
                          "pattern": "^[A-Za-z0-9._-]{1,60}$"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "dir",
            "names"
          ],
          "properties": {
            "action": {
              "const": "ssh-keypairs"
            },
            "dir": {
              "$ref": "#/$defs/relativePath"
            },
            "names": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/name"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "path",
            "archives"
          ],
          "properties": {
            "action": {
              "const": "collection-requirements"
            },
            "path": {
              "$ref": "#/$defs/relativePath"
            },
            "archives": {
              "description": "File name prefixes of collection archives already in the project, such as 'redhat-rhel_system_roles-'. The requirements file lists each by its absolute path.",
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9_]+-[a-z0-9_]+-$"
              }
            }
          }
        }
      ]
    },
    "checkService": {
      "allOf": [
        {
          "$ref": "#/$defs/checkBase"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "names"
      ],
      "properties": {
        "kind": {
          "const": "service"
        },
        "names": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/unitName"
          }
        },
        "active": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "checkFirewall": {
      "allOf": [
        {
          "$ref": "#/$defs/checkBase"
        }
      ],
      "unevaluatedProperties": false,
      "properties": {
        "kind": {
          "const": "firewall"
        },
        "service": {
          "$ref": "#/$defs/unitName"
        },
        "port": {
          "type": "string",
          "pattern": "^[0-9]{1,5}/(?:tcp|udp)$"
        },
        "allowed": {
          "type": "boolean",
          "default": true
        },
        "permanent": {
          "type": "boolean",
          "default": true
        },
        "runtime": {
          "type": "boolean",
          "default": true
        }
      },
      "oneOf": [
        {
          "required": [
            "service"
          ]
        },
        {
          "required": [
            "port"
          ]
        }
      ],
      "type": "object"
    },
    "checkPackage": {
      "allOf": [
        {
          "$ref": "#/$defs/checkBase"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "names"
      ],
      "properties": {
        "kind": {
          "const": "package"
        },
        "names": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/packageName"
          }
        },
        "installed": {
          "type": "boolean",
          "default": true
        }
      },
      "type": "object"
    },
    "checkFile": {
      "allOf": [
        {
          "$ref": "#/$defs/checkBase"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "paths"
      ],
      "properties": {
        "kind": {
          "const": "file"
        },
        "paths": {
          "description": "Checked in order; the check passes if any one path meets every condition (on 'control', paths are relative to the project).",
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/absolutePath"
              },
              {
                "$ref": "#/$defs/relativePath"
              }
            ]
          }
        },
        "exists": {
          "type": "boolean",
          "default": true
        },
        "nonEmpty": {
          "type": "boolean"
        },
        "contains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/literal"
          }
        },
        "lacks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/literal"
          }
        },
        "line": {
          "description": "A whole line that must be present.",
          "$ref": "#/$defs/literal"
        },
        "matches": {
          "$ref": "#/$defs/regex"
        },
        "contentEquals": {
          "description": "The file holds exactly one fact about the host.",
          "enum": [
            "kernel-release",
            "hostname-short",
            "fqdn"
          ]
        },
        "mode": {
          "$ref": "#/$defs/mode"
        },
        "owner": {
          "$ref": "#/$defs/account"
        },
        "group": {
          "$ref": "#/$defs/account"
        },
        "selinuxType": {
          "type": "string",
          "pattern": "^[a-z0-9_]+_t$"
        },
        "symlinkTo": {
          "$ref": "#/$defs/absolutePath"
        },
        "lines": {
          "description": "Whole lines that must all be present.",
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/literal"
          }
        },
        "fileType": {
          "description": "What the path must be: a regular file, a directory (not a link to one) or a symbolic link.",
          "enum": [
            "regular",
            "directory",
            "symlink"
          ]
        },
        "hardLinks": {
          "description": "The number of names (hard links) the file must have.",
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "sameFileAs": {
          "description": "Another path that must be the same file (a hard link to it, or the same name).",
          "anyOf": [
            {
              "$ref": "#/$defs/absolutePath"
            },
            {
              "$ref": "#/$defs/relativePath"
            }
          ]
        },
        "resolvesTo": {
          "description": "Where the path must lead once every symbolic link is followed, so relative and absolute links both pass.",
          "anyOf": [
            {
              "$ref": "#/$defs/absolutePath"
            },
            {
              "$ref": "#/$defs/relativePath"
            }
          ]
        }
      },
      "type": "object"
    },
    "checkFileCompare": {
      "allOf": [
        {
          "$ref": "#/$defs/checkBase"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "a",
        "b"
      ],
      "properties": {
        "kind": {
          "const": "file-compare"
        },
        "a": {
          "$ref": "#/$defs/absolutePath"
        },
        "b": {
          "$ref": "#/$defs/absolutePath"
        }
      },
      "type": "object"
    },
    "checkArchive": {
      "allOf": [
        {
          "$ref": "#/$defs/checkBase"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "kind": {
          "const": "archive"
        },
        "path": {
          "$ref": "#/$defs/absolutePath"
        },
        "format": {
          "enum": [
            "tar.gz",
            "tar.bz2",
            "tar.xz",
            "tar",
            "zip"
          ],
          "default": "tar.gz"
        }
      },
      "type": "object"
    },
    "checkUser": {
      "allOf": [
        {
          "$ref": "#/$defs/checkBase"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "names"
      ],
      "properties": {
        "kind": {
          "const": "user"
        },
        "names": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/account"
          }
        },
        "exists": {
          "type": "boolean",
          "default": true
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/account"
          }
        },
        "passwordSet": {
          "type": "boolean"
        },
        "authorizedKeys": {
          "description": "~/.ssh/authorized_keys exists, is non-empty, mode 600 and owned by the user.",
          "type": "boolean"
        },
        "homeFile": {
          "description": "A file in the user's home directory that must exist and be non-empty.",
          "$ref": "#/$defs/relativePath"
        }
      },
      "type": "object"
    },
    "checkMount": {
      "allOf": [
        {
          "$ref": "#/$defs/checkBase"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "kind": {
          "const": "mount"
        },
        "path": {
          "$ref": "#/$defs/absolutePath"
        },
        "fstype": {
          "enum": [
            "xfs",
            "ext4",
            "vfat",
            "nfs",
            "nfs4",
            "swap",
            "btrfs"
          ]
        },
        "persistent": {
          "description": "Also present in /etc/fstab.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "checkLogicalVolume": {
      "allOf": [
        {
          "$ref": "#/$defs/checkBase"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "vg",
        "lv"
      ],
      "properties": {
        "kind": {
          "const": "logical-volume"
        },
        "vg": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_+.-]{1,64}$"
        },
        "lv": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_+.-]{1,64}$"
        },
        "minSizeMiB": {
          "type": "integer",
          "minimum": 1
        }
      },
      "type": "object"
    },
    "checkHttp": {
      "allOf": [
        {
          "$ref": "#/$defs/checkBase"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "kind": {
          "const": "http"
        },
        "url": {
          "description": "Requested from the managed host itself.",
          "type": "string",
          "pattern": "^https?://(?:localhost|127\\.0\\.0\\.1|\\{host\\}|[a-z0-9.-]+\\.lab\\.example\\.com)(?::[0-9]{1,5})?(?:/[A-Za-z0-9._~/%-]*)?$"
        },
        "resolveToLocalhost": {
          "type": "boolean"
        },
        "insecure": {
          "description": "Accept a self-signed certificate.",
          "type": "boolean"
        },
        "containsAny": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/literal"
          }
        }
      },
      "type": "object"
    },
    "checkSelinux": {
      "allOf": [
        {
          "$ref": "#/$defs/checkBase"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "kind": {
          "const": "selinux"
        },
        "mode": {
          "enum": [
            "enforcing",
            "permissive",
            "disabled"
          ]
        },
        "persistent": {
          "type": "boolean",
          "default": true
        }
      },
      "type": "object"
    },
    "checkSudoers": {
      "allOf": [
        {
          "$ref": "#/$defs/checkBase"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "kind": {
          "const": "sudoers"
        },
        "path": {
          "$ref": "#/$defs/absolutePath"
        },
        "mode": {
          "$ref": "#/$defs/mode"
        },
        "owner": {
          "$ref": "#/$defs/account"
        },
        "group": {
          "$ref": "#/$defs/account"
        },
        "valid": {
          "description": "visudo accepts the file.",
          "type": "boolean",
          "default": true
        },
        "rules": {
          "description": "The file's only non-comment lines, exactly.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/literal"
          }
        }
      },
      "type": "object"
    },
    "checkSshd": {
      "allOf": [
        {
          "$ref": "#/$defs/checkBase"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "setting",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "sshd"
        },
        "setting": {
          "type": "string",
          "pattern": "^[a-z]{3,40}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9 ,._/-]{1,80}$"
        }
      },
      "type": "object"
    },
    "checkCron": {
      "allOf": [
        {
          "$ref": "#/$defs/checkBase"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "file"
      ],
      "properties": {
        "kind": {
          "const": "cron"
        },
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$",
          "description": "A file in /etc/cron.d."
        },
        "line": {
          "$ref": "#/$defs/literal"
        },
        "matches": {
          "$ref": "#/$defs/regex"
        },
        "present": {
          "type": "boolean",
          "default": true
        }
      },
      "type": "object"
    },
    "checkBootTarget": {
      "allOf": [
        {
          "$ref": "#/$defs/checkBase"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "target"
      ],
      "properties": {
        "kind": {
          "const": "boot-target"
        },
        "target": {
          "type": "string",
          "pattern": "^[a-z-]+\\.target$"
        }
      },
      "type": "object"
    },
    "checkAddress": {
      "allOf": [
        {
          "$ref": "#/$defs/checkBase"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "interface",
        "cidr"
      ],
      "properties": {
        "kind": {
          "const": "address"
        },
        "interface": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,15}$"
        },
        "cidr": {
          "type": "string",
          "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"
        },
        "persistent": {
          "description": "Also in the NetworkManager connection profile of the same name.",
          "type": "boolean",
          "default": true
        }
      },
      "type": "object"
    },
    "checkHostname": {
      "allOf": [
        {
          "$ref": "#/$defs/checkBase"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "short"
      ],
      "properties": {
        "kind": {
          "const": "hostname"
        },
        "short": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,63}$"
        }
      },
      "type": "object"
    },
    "checkCommands": {
      "allOf": [
        {
          "$ref": "#/$defs/checkBase"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "names"
      ],
      "properties": {
        "kind": {
          "const": "commands"
        },
        "names": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,64}$"
          }
        }
      },
      "type": "object"
    },
    "checkGit": {
      "allOf": [
        {
          "$ref": "#/$defs/checkBase"
        }
      ],
      "unevaluatedProperties": false,
      "properties": {
        "kind": {
          "const": "git"
        },
        "on": {
          "const": "control"
        },
        "remoteEndsWith": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]{1,200}$"
        },
        "minCommits": {
          "type": "integer",
          "minimum": 1
        },
        "clean": {
          "type": "boolean"
        },
        "pushedBranch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]{1,100}$"
        },
        "ignored": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "remoteHasPaths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        }
      },
      "type": "object"
    },
    "checkLint": {
      "allOf": [
        {
          "$ref": "#/$defs/checkBase"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "tool",
        "files",
        "image"
      ],
      "properties": {
        "kind": {
          "const": "lint"
        },
        "on": {
          "const": "control"
        },
        "tool": {
          "enum": [
            "ansible-lint"
          ]
        },
        "image": {
          "$ref": "#/$defs/imageRef"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        }
      },
      "type": "object"
    },
    "groupName": {
      "description": "An Ansible inventory group name.",
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
    }
  }
}
