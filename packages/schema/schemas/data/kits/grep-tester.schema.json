{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelpath.dev/schema/v1/data/kits/grep-tester.schema.json",
  "title": "grep tester",
  "description": "The words and data for the grep tester kit: a file's lines and grep patterns to try, with the -i, -v, -E and -n options.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text",
    "data",
    "props"
  ],
  "properties": {
    "text": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 4000
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false
    },
    "props": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lines"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "file": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[^\\s]+$"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 60,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "presets": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pattern"
            ],
            "properties": {
              "pattern": {
                "type": "string",
                "maxLength": 200
              },
              "flags": {
                "type": "string",
                "pattern": "^[ivEn]{0,4}$"
              },
              "note": {
                "type": "string",
                "maxLength": 600
              }
            }
          }
        }
      }
    }
  }
}
