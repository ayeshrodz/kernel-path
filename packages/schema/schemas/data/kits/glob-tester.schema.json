{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelpath.dev/schema/v1/data/kits/glob-tester.schema.json",
  "title": "Pattern tester",
  "description": "The words and data for the pattern tester kit: a directory of file names, a command, and patterns to try; it shows what Bash expands each pattern to.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text",
    "data",
    "props"
  ],
  "properties": {
    "text": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 4000
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false
    },
    "props": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "command": {
          "type": "string",
          "maxLength": 60
        },
        "initial": {
          "type": "string",
          "maxLength": 200
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 80,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[^/]+$"
          }
        },
        "presets": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pattern"
            ],
            "properties": {
              "pattern": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "note": {
                "type": "string",
                "maxLength": 600
              }
            }
          }
        }
      }
    }
  }
}
